{
  "schemaVersion": 2,
  "aspectRatio": "16:10",
  "rendering": "resolution-independent SVG",
  "rules": {
    "embeddedText": false,
    "people": false,
    "rotation": "deterministic by school date so recurring events vary without flicker",
    "placement": "selected-day detail only; month grid stays icon-and-label first",
    "schedulePriority": "No School and Half Day are independent schedule facets and remain visible even when other events share the date.",
    "multiEventHandling": "Month cells show schedule flag + primary event + compact additional-event count; selected day shows the full ordered stack.",
    "compositeSourceHandling": "Combined source lines such as Progress Reports; 12:00 dismissal are split into schedule and event facets."
  },
  "categories": {
    "picture": {
      "match": [
        "Picture Day",
        "school portraits"
      ],
      "variants": [
        "picture-day.svg",
        "picture-day-2.svg"
      ]
    },
    "mass": {
      "match": [
        "Mass",
        "Church"
      ],
      "variants": [
        "mass-1.svg",
        "mass-2.svg"
      ]
    },
    "gym": {
      "match": [
        "Gym"
      ],
      "variants": [
        "gym-1.svg",
        "gym-2.svg"
      ]
    },
